<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- 
                 %d{MM-dd HH:mm:ss} : Month-Day Time
                 [%-8.8t]           : Thread name, fixed to 8 chars (e.g., [orker-7])
                 %highlight(%-5level): Level (INFO, ERROR, etc.)
                 %cyan(%-15.15logger): Logger (e.g., p.c.u.AddFeed)
                 - %msg%n           : Message
            -->
            <pattern>%d{MM-dd HH:mm:ss} [%-8.8t] %highlight(%-5level) %cyan(%-15.15logger) - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>

    <!-- Silence common noise -->
    <logger name="org.eclipse.jetty" level="WARN"/>
    <logger name="io.netty" level="WARN"/>
    <logger name="io.ktor.server.plugins.di" level="WARN"/>
</configuration>