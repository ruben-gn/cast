<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- A simpler, quieter pattern for testing -->
            <pattern>%d{HH:mm:ss} %-5level %cyan(%-20.20logger) - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>

    <!-- Silence infrastructure noise to see only your domain logs -->
    <logger name="org.eclipse.jetty" level="WARN"/>
    <logger name="io.netty" level="WARN"/>
    <logger name="io.ktor" level="WARN"/>
    <logger name="io.mockk" level="WARN"/>
</configuration>
